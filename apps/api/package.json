{
  "name": "@hoa-mngr/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "generate": "dotenv -e .env.local -- ts-node -r tsconfig-paths/register src/generate-openapi.ts",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate --config=src/infrastructure/db/drizzle.config.ts",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate --config=src/infrastructure/db/drizzle.config.ts",
    "db:seed": "dotenv -e .env.local -- ts-node -r tsconfig-paths/register src/infrastructure/db/seed.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@date-fns/tz": "1.4.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "6.1.1",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@willsoto/nestjs-prometheus": "6.0.2",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.1",
    "nest-winston": "1.10.2",
    "nestjs-cls": "6.2.0",
    "nestjs-zod": "5.1.1",
    "openid-client": "5.6.5",
    "pg": "8.18.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "5.0.1",
    "winston": "3.19.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@hoa-mngr/eslint-config": "workspace:*",
    "@hoa-mngr/typescript-config": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "8.16.0",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.9",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.57.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
