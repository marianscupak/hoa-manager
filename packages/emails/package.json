{
    "name": "@hoa-mngr/emails",
    "version": "0.0.0",
    "private": true,
    "license": "UNLICENSED",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "preview": "email dev --dir src/templates --port 3002",
        "lint": "eslint \"src/**/*.{ts,tsx}\"",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@react-email/components": "1.0.12",
        "react": "19.2.4",
        "react-dom": "19.2.4"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@hoa-mngr/eslint-config": "workspace:*",
        "@hoa-mngr/typescript-config": "workspace:*",
        "@hoa-mngr/ui": "workspace:*",
        "@react-email/ui": "6.9.3",
        "@types/node": "22.19.11",
        "@types/react": "19.2.14",
        "eslint": "^10.0.2",
        "eslint-plugin-react": "7.37.5",
        "react-email": "6.9.3",
        "typescript": "5.5.4",
        "typescript-eslint": "8.57.0",
        "vitest": "4.1.11"
    }
}
