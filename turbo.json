{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**"]
        },
        "typecheck": {
            "dependsOn": ["^typecheck", "^build"]
        },
        "lint": { "dependsOn": ["^build"] },
        "test": {
            "dependsOn": ["^build"]
        },
        "format:check": {},
        "generate": {
            "dependsOn": ["^generate"]
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        }
    }
}
