{$DOMAIN} {
    # Structured access logs → docker stdout → Promtail → Loki (traffic
    # panels in Grafana are built from these).
    #
    # The query string is stripped before the line is written. Two endpoints
    # carry a live credential there — /api/invites/owner/status?token=… and
    # /api/auth/google/callback?code=… — and Caddy sees both before the API
    # does, so sanitising only the API side would leave the same secrets in
    # the same Loki. Everything goes rather than a list of named parameters,
    # matching sanitizeUrl() in the API: an allowlist only protects the
    # parameters somebody remembered to name.
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri regexp "\?.*$" ""
            }
        }
    }

    # Metrics are for the internal Prometheus scraper only.
    handle /api/metrics {
        respond "Forbidden" 403
    }

    handle /api/* {
        reverse_proxy api:3000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    encode gzip
}

# One canonical host. Visitors who type the www prefix land on the same site
# instead of a connection error, and cookies and sessions stay on a single
# origin rather than splitting between two.
#
# Requires a DNS record for www.{$DOMAIN} pointing at this server — without it
# Caddy cannot obtain a certificate for the name and this block never serves.
www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}

grafana.{$DOMAIN} {
    reverse_proxy grafana:3000
}
