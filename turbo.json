{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**"]
        },
        "typecheck": {
            "dependsOn": ["^typecheck"]
        },
        "lint": {},
        "test": {},
        "format:check": {},
        "generate": {
            "dependsOn": ["^generate"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
